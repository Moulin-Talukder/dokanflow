{
  "name": "dokanflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @dokanflow/db generate",
    "db:migrate": "pnpm --filter @dokanflow/db migrate:dev",
    "db:deploy": "pnpm --filter @dokanflow/db migrate:deploy",
    "db:test:create": "docker compose exec -T postgres psql -U postgres -d postgres -f /opt/dokanflow/test-database.sql",
    "db:test:deploy": "pnpm --filter @dokanflow/db migrate:deploy:test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
