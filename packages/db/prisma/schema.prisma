// DokanFlow database schema.
// The full planned schema is described in docs/SCHEMA.md. Models are added in the
// roadmap phase that needs them. Phase 1 has no business tables.
//
// Conventions: snake_case tables and columns via @@map/@map, UUID ids,
// timestamptz timestamps, money as integer poisha, tenant_id on every business table.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  // ESM with explicit .js import specifiers, so the generated TS compiles under
  // module/moduleResolution "NodeNext" like the rest of the monorepo.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 2: auth, tenants and RBAC
// RLS policies, CHECK constraints and partial indexes that Prisma cannot express
// live in the migration SQL. See docs/SCHEMA.md.
// ---------------------------------------------------------------------------

enum MembershipRole {
  owner
  manager
  cashier

  @@map("membership_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

/// Global identity (no RLS). Accessed only through the API's auth and user services.
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  /// Lowercased. Owners and managers sign in with it.
  email              String?    @unique
  /// Normalized E.164 (+8801XXXXXXXXX). Cashiers sign in with it.
  phone              String?    @unique
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  /// Informational only. Revocation uses auth_sessions, not timestamps (no clock-skew issues).
  passwordChangedAt  DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  status             UserStatus @default(active)
  /// Set when an owner created this account as staff; only that shop may reset its password.
  /// Cleared when the person creates their own business (the account is then self-managed).
  managedByTenantId  String?    @map("managed_by_tenant_id") @db.Uuid
  /// The shop selected at the last login or switch.
  lastTenantId       String?    @map("last_tenant_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  managedByTenant Tenant?         @relation("ManagedUsers", fields: [managedByTenantId], references: [id], onDelete: Restrict)
  lastTenant      Tenant?         @relation("LastTenant", fields: [lastTenantId], references: [id], onDelete: SetNull)
  memberships     Membership[]
  refreshTokens   RefreshToken[]
  sessions        AuthSession[]
  stockMovements  StockMovement[]
  salesCashiered  Sale[]          @relation("SaleCashier")
  salesVoided     Sale[]          @relation("SaleVoidedBy")

  @@map("users")
}

/// A business. Global (no RLS); members reach it through their memberships.
model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    TenantStatus @default(active)
  timezone  String       @default("Asia/Dhaka")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches        Branch[]
  memberships     Membership[]
  refreshTokens   RefreshToken[]
  managedUsers    User[]           @relation("ManagedUsers")
  lastUsers       User[]           @relation("LastTenant")
  categories      Category[]
  products        Product[]
  invoiceCounter  InvoiceCounter?
  idempotencyKeys IdempotencyKey[]

  @@map("tenants")
}

/// Tenant-scoped (RLS).
/// One default branch per tenant: `is_default` is TRUE or NULL (a CHECK forbids FALSE), and
/// the unique (tenant_id, is_default) allows any number of NULLs but only one TRUE. This
/// avoids a partial index, which the Prisma schema cannot describe.
model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// TRUE for the default branch, NULL otherwise.
  isDefault Boolean? @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]

  /// Target for composite (tenant_id, branch_id) foreign keys from later tables.
  @@unique([tenantId, id])
  @@unique([tenantId, isDefault])
  @@map("branches")
}

/// Tenant-scoped (RLS), plus a self-read policy so users can list their own shops.
model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Global (no RLS). One row per login. Access tokens carry its id (`sid`) and are
/// rejected once it is revoked or past `expires_at`, which rotation never extends.
model AuthSession {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Absolute end of the session, fixed at login.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

/// Global (no RLS): looked up by hash before any tenant context exists.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// The session's active shop.
  tenantId     String    @map("tenant_id") @db.Uuid
  /// The login session this token belongs to. Reuse of a rotated token revokes the session.
  sessionId    String    @map("session_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  /// Never later than the session's expires_at.
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("Rotation")

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Phase 3: products and inventory
// Triggers, CHECK constraints and privileges live in the migration SQL; see
// docs/SCHEMA.md. Stock levels change only through stock_movements.
// ---------------------------------------------------------------------------

enum ProductUnit {
  piece
  gram
  ml

  @@map("product_unit")
}

enum StockMovementType {
  opening
  purchase
  adjustment
  sale
  sale_void
  return

  @@map("stock_movement_type")
}

/// Tenant-scoped (RLS).
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, name])
  /// Target for composite (tenant_id, category_id) foreign keys.
  @@unique([tenantId, id])
  @@map("categories")
}

/// Tenant-scoped (RLS). Money in poisha; quantities in base units of `unit`.
model Product {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  categoryId        String?     @map("category_id") @db.Uuid
  name              String
  /// Uppercase; unique per tenant.
  sku               String
  barcode           String?
  /// Locked (trigger) once the product has any stock movement.
  unit              ProductUnit
  /// Shelf price including VAT, per piece / kg / litre.
  pricePoisha       Int         @map("price_poisha")
  costPoisha        Int         @map("cost_poisha")
  vatRateBp         Int?        @map("vat_rate_bp")
  /// Base units; at or below this the product is low on stock.
  lowStockThreshold Int?        @map("low_stock_threshold")
  archivedAt        DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Composite: a product can only use a category of its own tenant.
  category       Category?       @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  /// Target for composite (tenant_id, product_id) foreign keys.
  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("products")
}

/// Tenant-scoped (RLS). Read-only for app_user: written only by the
/// stock_movements trigger, so it always equals the sum of the movements.
model StockLevel {
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, branchId, productId])
  @@map("stock_levels")
}

/// Tenant-scoped (RLS). Append-only: app_user may insert but never update or delete.
/// A BEFORE INSERT trigger applies the delta to stock_levels and sets quantity_after.
model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  type          StockMovementType
  quantityDelta Int               @map("quantity_delta")
  /// Set by the trigger; any value supplied on insert is overwritten.
  quantityAfter Int               @default(0) @map("quantity_after")
  reason        String?
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id") @db.Uuid
  actorUserId   String            @map("actor_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Phase 4: POS and sales
// CHECK constraints, column privileges, the void guard and the deferred
// consistency triggers live in the migration SQL; see docs/SCHEMA.md.
// ---------------------------------------------------------------------------

enum SaleStatus {
  completed
  voided

  @@map("sale_status")
}

/// Phase 4 records cash only; the other methods arrive in Phase 5.
enum PaymentMethod {
  cash
  card
  mobile_wallet
  due

  @@map("payment_method")
}

enum DiscountType {
  amount
  percent

  @@map("discount_type")
}

/// Tenant-scoped (RLS). Immutable once written, except the void columns.
/// Totals are verified against the lines and payments at commit (deferred trigger).
model Sale {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  branchId           String        @map("branch_id") @db.Uuid
  /// Sequential per tenant, from invoice_counters; shown as INV-000123.
  invoiceNo          Int           @map("invoice_no")
  status             SaleStatus    @default(completed)
  cashierUserId      String        @map("cashier_user_id") @db.Uuid
  subtotalPoisha     Int           @map("subtotal_poisha")
  lineDiscountPoisha Int           @map("line_discount_poisha")
  /// The whole-sale discount as entered (amount in poisha, or percent in basis points).
  saleDiscountType   DiscountType? @map("sale_discount_type")
  saleDiscountValue  Int?          @map("sale_discount_value")
  saleDiscountPoisha Int           @map("sale_discount_poisha")
  /// VAT contained in the total.
  taxPoisha          Int           @map("tax_poisha")
  totalPoisha        Int           @map("total_poisha")
  paidPoisha         Int           @map("paid_poisha")
  duePoisha          Int           @map("due_poisha")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt           DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedByUserId     String?       @map("voided_by_user_id") @db.Uuid
  voidReason         String?       @map("void_reason")

  branch   Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  cashier  User          @relation("SaleCashier", fields: [cashierUserId], references: [id], onDelete: Restrict)
  voidedBy User?         @relation("SaleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments SalePayment[]

  @@unique([tenantId, invoiceNo])
  /// Target for composite (tenant_id, sale_id) foreign keys.
  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sales")
}

/// Tenant-scoped (RLS). Append-only. Every price, rate and name is a snapshot.
model SaleItem {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  saleId                  String        @map("sale_id") @db.Uuid
  lineNo                  Int           @map("line_no")
  productId               String        @map("product_id") @db.Uuid
  productName             String        @map("product_name")
  productSku              String        @map("product_sku")
  unit                    ProductUnit
  /// Base units.
  quantity                Int
  unitPricePoisha         Int           @map("unit_price_poisha")
  grossPoisha             Int           @map("gross_poisha")
  discountType            DiscountType? @map("discount_type")
  discountValue           Int?          @map("discount_value")
  lineDiscountPoisha      Int           @map("line_discount_poisha")
  saleDiscountSharePoisha Int           @map("sale_discount_share_poisha")
  totalPoisha             Int           @map("total_poisha")
  vatRateBp               Int?          @map("vat_rate_bp")
  taxPoisha               Int           @map("tax_poisha")

  sale    Sale    @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([saleId, lineNo])
  @@index([tenantId, productId])
  @@map("sale_items")
}

/// Tenant-scoped (RLS). Append-only. One row per payment method used.
model SalePayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  method         PaymentMethod
  /// Amount applied to the sale.
  amountPoisha   Int           @map("amount_poisha")
  /// Cash handed over, and the change given back (cash only).
  tenderedPoisha Int?          @map("tendered_poisha")
  changePoisha   Int?          @map("change_poisha")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, saleId])
  @@map("sale_payments")
}

/// Tenant-scoped (RLS). One row per tenant; incremented atomically inside the sale
/// transaction, so invoice numbers are sequential and gap-free.
model InvoiceCounter {
  tenantId  String @id @map("tenant_id") @db.Uuid
  lastValue Int    @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("invoice_counters")
}

/// Tenant-scoped (RLS). One row per idempotent request: the hash of what was asked
/// and the id of what was created, so a retry returns the original result.
model IdempotencyKey {
  tenantId    String   @map("tenant_id") @db.Uuid
  /// What the key was used for, e.g. "sale" or "stock-in".
  scope       String
  key         String
  requestHash String   @map("request_hash")
  resourceId  String?  @map("resource_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, scope, key])
  @@map("idempotency_keys")
}
