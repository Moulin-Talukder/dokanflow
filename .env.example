# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only placeholder. Never put real secrets in this file.

NODE_ENV=development
LOG_LEVEL=info

# --- Docker Compose (local infrastructure) -----------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
# Superuser for the local container only. The apps never use it.
POSTGRES_PASSWORD=postgres_local_only
# Schema owner: runs migrations.
DOKANFLOW_OWNER_PASSWORD=owner_local_only
# Runtime role: NOSUPERUSER NOBYPASSRLS, so Row Level Security applies.
DOKANFLOW_APP_PASSWORD=app_local_only

# --- Database -----------------------------------------------------------------
# Used by the API and worker at runtime (role: app_user).
DATABASE_URL=postgresql://app_user:app_local_only@localhost:5432/dokanflow
# Used only by the Prisma CLI for migrations (role: dokanflow, the schema owner).
MIGRATION_DATABASE_URL=postgresql://dokanflow:owner_local_only@localhost:5432/dokanflow

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ----------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed by CORS.
API_CORS_ORIGINS=http://localhost:3000

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
