# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only placeholder. Never put real secrets in this file.

NODE_ENV=development
LOG_LEVEL=info

# --- Docker Compose (local infrastructure) -----------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
# Superuser for the local container only. The apps never use it.
POSTGRES_PASSWORD=postgres_local_only
# Schema owner: runs migrations.
DOKANFLOW_OWNER_PASSWORD=owner_local_only
# Runtime role: NOSUPERUSER NOBYPASSRLS, so Row Level Security applies.
DOKANFLOW_APP_PASSWORD=app_local_only

# --- Database -----------------------------------------------------------------
# Used by the API and worker at runtime (role: app_user).
DATABASE_URL=postgresql://app_user:app_local_only@localhost:5432/dokanflow
# Used only by the Prisma CLI for migrations (role: dokanflow, the schema owner).
MIGRATION_DATABASE_URL=postgresql://dokanflow:owner_local_only@localhost:5432/dokanflow

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Integration tests ----------------------------------------------------------
# Integration tests use ONLY these. They refuse to run unless the database name
# ends in "_test" and differs from DATABASE_URL, and unless the Redis database
# index differs from REDIS_URL. Create and migrate with:
#   pnpm db:test:create && pnpm db:test:deploy
TEST_DATABASE_URL=postgresql://app_user:app_local_only@localhost:5432/dokanflow_test
TEST_MIGRATION_DATABASE_URL=postgresql://dokanflow:owner_local_only@localhost:5432/dokanflow_test
TEST_REDIS_URL=redis://localhost:6379/1

# --- API ----------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed by CORS. Also used for CSRF origin checks.
API_CORS_ORIGINS=http://localhost:3000

# --- Auth ---------------------------------------------------------------------
# HMAC key for access tokens. Generate your own: openssl rand -base64 48
JWT_ACCESS_SECRET=local-only-change-me-0123456789abcdefghijklmnop
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie flags. Secure defaults to true when NODE_ENV=production.
# Use SameSite=strict when web and API share a site (localhost:3000 + localhost:4000,
# or app.example.com + api.example.com); use none (with Secure) for different sites.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
# AUTH_COOKIE_DOMAIN=

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
